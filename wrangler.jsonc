{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liteos",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "vars": {
    "AI_MODEL": "gemma4:31b"
  },
  "observability": {
    "enabled": true
  },
  "dev": {
    "inspector_port": 9230
  },
  "assets": {
    "directory": "dist/client",
    "binding": "GAME_ASSETS",
    "run_worker_first": true
  }
}
